# API port
PORT=3001

# Storage. Leave DATABASE_URL unset to use the zero-dependency file store at
# ./data/reviews.json (local only). Set it for Postgres; apply
# src/store/schema.sql first.
# DATABASE_URL=postgres://user:pass@localhost:5432/tabular_review
# DATA_FILE=./data/reviews.json

# Extraction provider. "stub" runs without a model (deterministic passages
# from the documents); "anthropic" uses Claude. Defaults to anthropic when an
# API key is present, otherwise stub.
# EXTRACTION_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5

# Stub provider: delay per cell in ms, so the grid visibly streams.
STUB_DELAY_MS=250
